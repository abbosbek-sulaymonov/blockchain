# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — it is gitignored on purpose.
# Use a THROWAWAY wallet for testnets. Never put a mainnet key in a repo.
# ---------------------------------------------------------------------------

# --- Contracts (packages/contracts) ---
# JSON-RPC endpoint for the Sepolia testnet (Alchemy / Infura / drpc / public).
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
# Private key of a throwaway deployer account, 0x-prefixed.
SEPOLIA_PRIVATE_KEY=""
# For `hardhat verify` — https://etherscan.io/myapikey
ETHERSCAN_API_KEY=""

# --- Indexer API (apps/api) ---
API_PORT="4000"
# RPC the indexer polls. Defaults to the local Hardhat node.
RPC_URL="http://127.0.0.1:8545"
# Chain id the indexer expects: 31337 = local Hardhat, 11155111 = Sepolia.
CHAIN_ID="31337"
# Deployed ProgressTracker address (printed by the deploy script).
PROGRESS_TRACKER_ADDRESS=""
# Blocks to wait before treating one as final. Leave unset for a per-chain default:
# 0 on a local Hardhat node (it only mines on demand), 2 on a public chain.
INDEXER_CONFIRMATIONS=""
# Requests allowed per IP per window, and the window in milliseconds.
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"
# Set to "false" only when something in front of the API already rate-limits.
RATE_LIMIT_ENABLED="true"

# --- Web dApp (apps/web) ---
# NEXT_PUBLIC_* vars are shipped to the browser. Never put a secret here.
NEXT_PUBLIC_CHAIN_ID="31337"
NEXT_PUBLIC_RPC_URL="http://127.0.0.1:8545"
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"
NEXT_PUBLIC_PROGRESS_TRACKER_ADDRESS=""
NEXT_PUBLIC_LEARN_TOKEN_ADDRESS=""
