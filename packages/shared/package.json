{
  "name": "@blockchain/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contract ABIs, addresses, chain config and milestone metadata shared by the API and the web app.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@blockchain/tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "viem": "^2.56.3",
    "@blockchain/contracts": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.56.3"
  }
}
