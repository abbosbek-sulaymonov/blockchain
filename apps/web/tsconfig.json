{
  "extends": "@blockchain/tsconfig/nextjs.json",
  "compilerOptions": {
    // No `baseUrl`: it is deprecated in TypeScript 6 and removed in 7. Since TS 4.4,
    // `paths` entries resolve relative to this file's directory on their own.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
