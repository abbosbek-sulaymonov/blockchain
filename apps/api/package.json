{
  "name": "@blockchain/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify service that indexes ProgressTracker events off-chain and serves them over REST.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@blockchain/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.4",
    "viem": "^2.56.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@blockchain/tsconfig": "workspace:*",
    "@types/node": "^22.19.0",
    "dotenv": "^17.2.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
